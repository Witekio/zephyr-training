#include <zephyr/dt-bindings/display/panel.h>

/ {
    chosen {
        zephyr,display = &ili9488_display_riverdi_pcb_035_nucleo144;
        zephyr,touch = &ili2130_touch_riverdi_pcb_035_nucleo144;
    };

    lvgl_pointer {
        compatible = "zephyr,lvgl-pointer-input";
        display = <&ili9488_display_riverdi_pcb_035_nucleo144>;
        input = <&ili2130_touch_riverdi_pcb_035_nucleo144>;
        swap-xy;
        invert-x;
    };

    backlight_pwm {
        compatible = "regulator-fixed";
        enable-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>; //CN7-2 - PB8
        regulator-boot-on;
        regulator-name = "LDC backlight regulator";
    };

    ili9488_display_riverdi_pcb_035_nucleo144 {
    compatible = "zephyr,mipi-dbi-spi";
    spi-dev = <&spi1>;
    dc-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>; // CN9-16 - PE4
    reset-gpios = <&gpioe 11 GPIO_ACTIVE_LOW>; // CN10-6 - PE11
    write-only;
    #address-cells = <1>;
    #size-cells = <0>;

    ili9488_display_riverdi_pcb_035_nucleo144: ili9488@0{
        compatible = "ilitek,ili9488";
        mipi-max-frequency = <25000000>;
        reg = <0>;
        pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
        height = <320>;
        width = <480>;
        display-inversion;
        pgamctrl = [00 03 09 08 16 0a 3f 78 4c 09 0a 08 16 1a 0f];
        ngamctrl = [00 16 19 03 0f 05 32 45 46 04 0e 0d 35 37 0f];
        };
    };
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pg9 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //CN9.2 - PD7
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	status = "okay";

    ili2130_touch_riverdi_pcb_035_nucleo144: ili2132a@41{
        compatible = "ilitek,ili2132a";
        reg = <0x41>;
        irq-gpios = <&gpioe 5 GPIO_ACTIVE_LOW>; //CN9-18 - PE5
        rst-gpios = <&gpioe 6 GPIO_ACTIVE_LOW>; //CN9-20 - PE6
    };
};